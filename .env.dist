# Base
APP_NAME="izero-print-module"

# Database
DATABASE_HOSTNAME=""
DATABASE_PORT=""
DATABASE_PASSWORD=""
DATABASE_NAME=""
DATABASE_USERNAME=""

# CORS (comma-separated)
CORS_ALLOW_ORIGINS=""
CORS_ALLOW_METHODS=""
CORS_ALLOW_HEADERS=""

# Sentry (empty DSN disables Sentry)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# HTTP audit (comma-separated)
HTTP_AUDIT_SENSITIVE_HEADERS="authorization,cookie,set-cookie,x-api-key,proxy-authorization"
HTTP_AUDIT_MAX_BODY_LENGTH=10000

# Printing (directory with the document templates)
TEMPLATES_DIR="app/infrastructure/templates"
